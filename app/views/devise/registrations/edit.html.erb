<div class="dropdown-container">
  <h2>設定</h2>
  <div class="account-container">
    <ul class="account-section">
      <li class="account-link-active"><%= link_to "アカウント", account_path, style: "text-decoration: none;" %></li>
      <li class="account-link"><%= link_to "プロフィール", user_path(current_user), style: "text-decoration: none;" %></li>
    </ul>
    <div class="account-content">
      <div class="account-header">
        <h2>アカウント</h2>
      </div>
      <%= form_for(resource, as: resource_name, url: registration_path(current_user), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: current_user %>

    <div class="field">
      <div class="account-info">
        <strong class="account-info-item-edit"><%= f.label :email, "メールアドレス" %></strong>
        <span><%= f.email_field :email, autofocus: true, autocomplete: "email" %></span>
      </div>
      <% if devise_mapping.confirmable? && current_user.pending_reconfirmation? %>
        <div>Currently waiting confirmation for: <%= current_user.unconfirmed_email %></div>
      <% end %>
      <div class="account-info">
        <strong class="account-info-item-edit"><%= f.label :password, "新しいパスワード" %></strong>
        <span><%= f.password_field :password, autocomplete: "new-password" %></span><br>
        <i>(※変更する場合のみ)</i>
      </div>
      <div class="account-info">
        <strong class="account-info-item-edit"><%= f.label :password_confirmation, "新しいパスワード（確認用）" %></strong>
        <span><%= f.password_field :password_confirmation, autocomplete: "new-password" %></span><br>
        <i>(※変更する場合のみ)</i>
      </div>
      <div class="account-info">
        <strong class="account-info-item-edit"><%= f.label :current_password, "現在のパスワード" %></strong>
        <span><%= f.password_field :current_password, autocomplete: "current-password" %></span><br>
      </div>

      <div class="actions">
        <%= f.submit "保存", class: "actions-btn" %>
      </div>
      <% end %>
      
      <%= link_to :back do %>
      <button class="another-link">戻る</button>
      <% end %>
      </div>
    </div>
  </div>
</div>
