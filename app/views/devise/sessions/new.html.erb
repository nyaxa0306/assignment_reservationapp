<div class="container">
  <h2 class="page-title">ログイン</h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="field">
      <%= f.label :email, "メールアドレス" %><br />
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input-field" %>
    </div>
  
    <div class="field">
      <%= f.label :password, "パスワード" %><br />
      <%= f.password_field :password, autocomplete: "current-password", class: "input-field" %>
    </div>

    <div class="actions">
      <%= f.submit "ログイン", class: "actions-btn" %>
    </div>
  <% end %>

  <%= link_to :new_user_registration do %>
    <button class="another-link">新しいアカウントを作成</button>
  <% end %>
</div>
