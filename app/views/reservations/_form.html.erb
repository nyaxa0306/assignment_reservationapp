<%= form_with model: [@room, @room.reservations.new] do |f| %>
  <% if @room.errors.any? %>
  <% end %>
  <div class="reservation-form">
    <div>
      <%= f.label :start_date, "チェックイン" %>
      <%= f.date_field :start_date %>
    </div>
    <% if @room.errors.include?(:start_date) %>
      <p style="color: red; text-align: center;"><%= @room.errors.full_messages_for(:start_date).first %>
    <% end %>

    <div>
      <%= f.label :end_date, "チェックアウト" %>
      <%= f.date_field :end_date %>
    </div>
    <div>
      <%= f.label :num_user, "人数" %>
      <%= f.text_field :num_user %>
    </div>
  </div>
  <% if user_signed_in? %>
    <%= f.submit "予約する", class: "reservation-btn" %>
  <% else %>
    <%= link_to new_user_session_path do %>
      <button class="reservation-btn">ログイン</button>
    <% end %>
  <% end %>
<% end %>
