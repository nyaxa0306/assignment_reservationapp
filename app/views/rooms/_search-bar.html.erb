<div class="search-bar">
  <%= form_with url: rooms_path, method: :get, local: true do |f| %>
    <%= f.text_field :address, value: params[:address], placeholder: "エリア名を入力", include_blank: "すべて", class: "search-bar-item" %>
    <%= f.text_field :keyword, value: params[:keyword], placeholder: "キーワードを入力", class: "search-bar-item" %>
    <%= f.submit "検索", class: "search-bar-btn" %>
  <% end %>
</div>
